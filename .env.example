# Streamlit 대시보드에서 FastAPI 파서 서비스에 접근하기 위한 URL
# 로컬 개발: http://localhost:8000
# Docker 환경: http://python-parser:8000
API_URL=http://localhost:8000

# PostgreSQL 연결 URL
# 로컬 개발: postgresql://postgres:postgres@localhost:5432/loginsight
# Docker 환경: postgresql://postgres:postgres@postgres:5432/loginsight
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loginsight
